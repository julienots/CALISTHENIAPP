{
  "name": "gravitas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "dev": "node scripts/fetch-assets.mjs && vite",
    "build": "node scripts/fetch-assets.mjs && tsc -b && vite build",
    "lint": "oxlint src",
