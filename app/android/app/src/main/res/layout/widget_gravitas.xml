<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GRAVITAS" android:textColor="#FFFF7A1A" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.15" />
        <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/7" android:textColor="#B3FFFFFF" android:textSize="11sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 0" android:textColor="#FFFFCF3F" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day0" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day1" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day2" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day3" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day4" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day5" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/lbl6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L" android:textColor="#99FFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/day6" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:background="@drawable/widget_day_future" android:gravity="center" android:textColor="#FF1A0B04" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:text="Ouvre GRAVITAS pour commencer" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn_done" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1.4" android:background="@drawable/widget_btn_primary" android:gravity="center" android:text="✓ Valider" android:textColor="#FF1A0B04" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_log" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="+ Noter" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_rest" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="0.8" android:layout_marginStart="6dp" android:background="@drawable/widget_btn" android:gravity="center" android:text="Repos" android:textColor="#FFFFCF3F" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
